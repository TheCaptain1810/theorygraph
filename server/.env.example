# Copy to server/.env. Never commit real values. See docs/engineering/ENVIRONMENT.md.

# PostgreSQL connection string (server only). Default below matches docker-compose.yml.
# For Supabase, use Connect -> ORM -> Session pooler (the direct host is IPv6-only), e.g.
#   postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Never point TEST_DATABASE_URL or the e2e database at Supabase.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/theorygraph

# API port and the browser origin allowed by CORS.
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Supabase Auth. The server verifies bearer tokens against your project.
# SUPABASE_ANON_KEY takes the publishable key (sb_publishable_...), the successor to the anon key.
# If these are empty the API still serves public reads, but every write returns 401.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# TMDB (film search/import). Optional: without it, /api/metadata returns 503 and the seeded
# catalogue still works. A v3 API key or a v4 read-access token both work. Server only, never VITE_.
# Review TMDB's terms (attribution, caching, non-commercial vs commercial use) before launch.
TMDB_API_KEY=

# SUPABASE_SERVICE_ROLE_KEY is intentionally NOT used yet. Add it only for a
# privileged server-side operation, and never expose it to the browser.

# Optional: enables the PostgreSQL integration tests (server/test/db.integration.test.ts).
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/theorygraph_test
