# Copy to e2e/.env (gitignored). A real, already-confirmed Supabase account used only by `npm run e2e`.
# Use a throwaway account with a password you do not use anywhere else.
# Real environment variables (for example CI secrets) take precedence over this file.
E2E_USERNAME=
E2E_EMAIL=
E2E_PASSWORD=

# Optional. Must be a database whose name ends in _e2e: it is emptied and reseeded on every run.
# E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/theorygraph_e2e
