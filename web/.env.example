# Copy to web/.env. Only public values belong here: everything VITE_* is shipped to the browser.
VITE_API_URL=http://localhost:4000

# Supabase sign-in. Use the project URL and the publishable key (sb_publishable_..., formerly the
# "anon" key). It is safe in the browser ONLY if Row Level Security is on for any exposed table.
# Never put the secret / service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
